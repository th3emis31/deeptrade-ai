//@version=5
// ============================================================================
// Volatility Trend Breakout - Better Exits + Dashboard  —  v2 (audited build)
// ----------------------------------------------------------------------------
// Same strategy, same defaults, same numbers when the new toggles are left off.
// Nothing was removed. Three things were added, each one testable on its own:
//
//   1. "Use a real limit order for TP1" (default ON)
//      v1 exited the first half with strategy.close on the bar that touched TP1.
//      With process_orders_on_close=true that fills at the BAR'S CLOSE, not at
//      TP1. Breakout bars that reach TP1 tend to close near their high, so the
//      modelled fill was on average better than a live one. v2 places a resting
//      limit order at tp1Price instead. Turn this OFF to reproduce v1 exactly.
//
//   2. Leverage cap on position size (default 5x, 0 disables)
//      v1 set no margin_long, so the tester allowed unlimited leverage. Risk-based
//      sizing in a low-ATR stretch can ask for 4x equity or more. The cap makes
//      the size executable at a real broker.
//
//   3. Optional session filter (default OFF, so results do not move)
//      Gold around a release is where a breakout meets its worst slippage.
//
// Read strategies/AUDIT_volatility_trend_breakout.md for the full findings.
// Test ONE change at a time so you know which change moved the result.
// ============================================================================

strategy("Volatility Trend Breakout v2 - Better Exits + Dashboard",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     slippage=2,
     margin_long=5,
     process_orders_on_close=true)

// ====================== INPUTS ======================
grpTrend = "Trend Filter"
emaLen       = input.int(50, "Trend EMA", group=grpTrend)
useEmaFilter = input.bool(true, "Require price above EMA", group=grpTrend)

grpBreakout = "Breakout Settings"
donchianLen  = input.int(20, "Donchian Length", group=grpBreakout)
atrLen       = input.int(14, "ATR Length", group=grpBreakout)
atrMult      = input.float(1.4, "Breakout ATR Multiplier", step=0.1, group=grpBreakout)

grpFilter = "Quality Filters"
useRsi       = input.bool(true, "RSI Filter", group=grpFilter)
rsiLen       = input.int(14, "RSI Length", group=grpFilter)
rsiMin       = input.float(52, "Min RSI for Long", group=grpFilter)
useVolume    = input.bool(true, "Volume Filter", group=grpFilter)
volMaLen     = input.int(20, "Volume MA", group=grpFilter)

grpRisk = "Risk Management"
riskPercent  = input.float(0.85, "Risk % of Equity", step=0.1, group=grpRisk)
slAtrMult    = input.float(1.5, "Stop Loss (x ATR)", step=0.1, group=grpRisk)
tp1R         = input.float(1.3, "TP1 (R-multiple)", step=0.1, group=grpRisk)
tp2R         = input.float(2.8, "Final TP (R-multiple)", step=0.1, group=grpRisk)

grpTrail = "Trailing & Exit"
useTrail     = input.bool(true, "Trailing after TP1", group=grpTrail)
trailAtr     = input.float(2.2, "Trail Distance (x ATR)", step=0.1, group=grpTrail)
useTimeExit  = input.bool(true, "Max Bars Exit", group=grpTrail)
maxBars      = input.int(65, "Max Bars in Trade", group=grpTrail)
beAtr        = input.float(0.15, "Breakeven offset after TP1 (x ATR)", step=0.05, group=grpTrail)

grpAudit = "Audit fixes (v2)"
useLimitTp1  = input.bool(true, "Use a real limit order for TP1", group=grpAudit,
     tooltip="ON: the first half exits with a resting limit order AT TP1, which is what a live account does. OFF: v1 behaviour, a market order on the bar that touches TP1, filled at that bar's close. Compare the two runs: a large drop means the exits were a fill-model artefact.")
maxLeverage  = input.float(5.0, "Max leverage on position size", minval=0, step=0.5, group=grpAudit,
     tooltip="Caps quantity at this multiple of equity. 0 disables the cap and restores v1 sizing, which the tester allowed because no margin was set.")
useSession   = input.bool(false, "Restrict entries to a session", group=grpAudit,
     tooltip="OFF by default so results are unchanged. Turn on to keep entries out of thin or release-driven hours.")
sessionWin   = input.session("0700-2000", "Session window", group=grpAudit)

grpVisual = "Visuals"
showDash     = input.bool(true, "Show Dashboard", group=grpVisual)

// ====================== CALCULATIONS ======================
ema50  = ta.ema(close, emaLen)
atr    = ta.atr(atrLen)
rsi    = ta.rsi(close, rsiLen)
volMa  = ta.sma(volume, volMaLen)

upper  = ta.highest(high, donchianLen)
lower  = ta.lowest(low, donchianLen)

breakoutUp = close > upper[1] and close > upper[1] + atrMult * atr * 0.25

trendOk = not useEmaFilter or close > ema50
rsiOk   = not useRsi or rsi > rsiMin
volOk   = not useVolume or volume > volMa * 1.0
sessOk  = not useSession or not na(time(timeframe.period, sessionWin))

longSignal = breakoutUp and trendOk and rsiOk and volOk and sessOk

// ====================== RISK-BASED ENTRY ======================
var float entryPrice = na
var float stopPrice  = na
var float tp1Price   = na
var float tp2Price   = na
var float highSince  = na
var int   barsHeld   = 0
var bool  tp1Taken   = false
var float qty        = na
var float entryQty   = na
var bool  sizeCapped = false

if longSignal and strategy.position_size == 0
    stopPrice := close - slAtrMult * atr
    riskDist  = close - stopPrice

    riskAmount = strategy.equity * (riskPercent / 100)
    qtyRisk = riskDist > 0 ? riskAmount / riskDist : na
    // A real broker will not hand you unlimited leverage just because the stop is tight.
    qtyCap = maxLeverage > 0 and close > 0 ? strategy.equity * maxLeverage / close : na
    qty := na(qtyCap) or na(qtyRisk) ? qtyRisk : math.min(qtyRisk, qtyCap)
    sizeCapped := not na(qtyCap) and not na(qtyRisk) and qtyRisk > qtyCap

    entryPrice := close
    tp1Price   := close + riskDist * tp1R
    tp2Price   := close + riskDist * tp2R
    highSince  := high
    barsHeld   := 0
    tp1Taken   := false
    entryQty   := qty

    if not na(qty) and qty > 0
        strategy.entry("Long", strategy.long, qty=qty)

// ====================== TRADE MANAGEMENT ======================
if strategy.position_size > 0
    barsHeld += 1
    highSince := math.max(highSince, high)

    // Works for both fill models: TP1 is done once the position has shrunk.
    if not tp1Taken and not na(entryQty) and strategy.position_size < entryQty * 0.9
        tp1Taken := true
        stopPrice := entryPrice + atr * beAtr

    trailStop = highSince - trailAtr * atr
    activeStop = useTrail and tp1Taken ? math.max(stopPrice, trailStop) : stopPrice

    if useLimitTp1
        // Resting orders: half leaves AT tp1Price, the runner at tp2Price. Both
        // carry the same protective stop, so the position is never unprotected.
        if not tp1Taken
            strategy.exit("TP1", from_entry="Long", qty_percent=50, limit=tp1Price, stop=activeStop)
        strategy.exit("Exit", from_entry="Long", limit=tp2Price, stop=activeStop)
    else
        // v1 behaviour, kept so the original numbers can be reproduced exactly.
        if not tp1Taken and high >= tp1Price
            strategy.close("Long", qty_percent=50, comment="TP1 (bar close)")
            tp1Taken := true
            stopPrice := entryPrice + atr * beAtr
        strategy.exit("Exit", from_entry="Long", stop=activeStop, limit=tp2Price)

    if useTimeExit and barsHeld >= maxBars
        strategy.close("Long", comment="Time Exit")

// ====================== PLOTS ======================
plot(ema50, "EMA 50", color=color.blue, linewidth=2)
plot(upper, "Donchian Upper", color=color.new(color.gray, 50))
plot(lower, "Donchian Lower", color=color.new(color.gray, 50))

plotshape(longSignal and strategy.position_size == 0, title="Breakout Long",
     style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)

plot(strategy.position_size > 0 ? entryPrice : na, "Entry", color=color.white, style=plot.style_linebr)
plot(strategy.position_size > 0 ? stopPrice : na, "Stop", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size > 0 ? tp1Price : na, "TP1", color=color.teal, style=plot.style_linebr)
plot(strategy.position_size > 0 ? tp2Price : na, "TP2", color=color.green, style=plot.style_linebr)

// ====================== IMPROVED DASHBOARD ======================
var table dash = table.new(position.top_right, 2, 11, bgcolor=color.new(#000000, 75), border_width=1)

if showDash and barstate.islast
    inTrade = strategy.position_size > 0
    pnlPct  = inTrade ? (close - entryPrice) / entryPrice * 100 : na
    riskDist = inTrade ? entryPrice - stopPrice : na
    rrNow   = inTrade and riskDist > 0 ? (close - entryPrice) / riskDist : na

    // Header
    table.cell(dash, 0, 0, "Metric", text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(dash, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.gray, 30))

    // Status
    table.cell(dash, 0, 1, "Status", text_color=color.white)
    table.cell(dash, 1, 1, inTrade ? "LONG" : "FLAT", text_color=inTrade ? color.lime : color.gray)

    // Risk
    table.cell(dash, 0, 2, "Risk %", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(riskPercent, "#.##") + "%", text_color=color.yellow)

    // Entry
    table.cell(dash, 0, 3, "Entry", text_color=color.white)
    table.cell(dash, 1, 3, inTrade ? str.tostring(entryPrice, format.mintick) : "-", text_color=color.white)

    // Stop
    table.cell(dash, 0, 4, "Stop", text_color=color.white)
    table.cell(dash, 1, 4, inTrade ? str.tostring(stopPrice, format.mintick) : "-", text_color=color.red)

    // TP1 / TP2
    table.cell(dash, 0, 5, "TP1 / TP2", text_color=color.white)
    table.cell(dash, 1, 5, inTrade ? str.tostring(tp1Price, format.mintick) + " | " + str.tostring(tp2Price, format.mintick) : "-", text_color=color.teal)

    // Current P/L %
    table.cell(dash, 0, 6, "P/L %", text_color=color.white)
    table.cell(dash, 1, 6, inTrade ? str.tostring(pnlPct, "#.##") + "%" : "-", text_color = inTrade and pnlPct >= 0 ? color.lime : inTrade ? color.red : color.gray)

    // Current R-multiple
    table.cell(dash, 0, 7, "Current R", text_color=color.white)
    table.cell(dash, 1, 7, inTrade ? str.tostring(rrNow, "#.##") + "R" : "-", text_color = inTrade and rrNow >= 0 ? color.lime : inTrade ? color.red : color.gray)

    // Bars held
    table.cell(dash, 0, 8, "Bars Held", text_color=color.white)
    table.cell(dash, 1, 8, inTrade ? str.tostring(barsHeld) : "-", text_color=color.white)

    // v2: which fill model produced this run
    table.cell(dash, 0, 9, "TP1 fill", text_color=color.white)
    table.cell(dash, 1, 9, useLimitTp1 ? "limit @ TP1" : "market @ close", text_color=useLimitTp1 ? color.lime : color.orange)

    // v2: did the leverage cap bind on the current trade
    table.cell(dash, 0, 10, "Size capped", text_color=color.white)
    table.cell(dash, 1, 10, maxLeverage <= 0 ? "no cap" : sizeCapped ? "YES" : "no", text_color=maxLeverage <= 0 ? color.orange : sizeCapped ? color.yellow : color.gray)
